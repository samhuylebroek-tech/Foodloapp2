# Foodloapp — namen van de omgevingsvariabelen. GEEN waarden in dit bestand of in git.
# Kopieer naar .env (staat in .gitignore) en vul lokaal in. Voor ontwikkelen is dit niet nodig:
# `npm run demo` gebruikt een nep-databank met verzonnen gegevens.

# App (browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_FOODLO_APP_URL=
VITE_FOODLO_MARKETING_URL=
VITE_APP_VERSION=

# Server (nooit in de browser, nooit in de cloudomgeving van Claude)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_API_KEY=
LOVABLE_SEND_URL=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
RESEND_API_KEY=
MAIL_AFZENDER=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
